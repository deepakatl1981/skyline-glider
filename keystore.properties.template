# Copy this file to keystore.properties and fill in your real values.
#
# keystore.properties and *.jks are gitignored — NEVER commit them. If you lose
# this keystore you can no longer publish updates to the same Play listing.
# Back it up somewhere durable (password manager, encrypted drive) today.
#
# Create the keystore with:
#
#   keytool -genkey -v \
#     -keystore skyline-glider-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias skyline
#
# Run it from this folder. It will prompt for passwords and your name/org.

storeFile=skyline-glider-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=skyline
keyPassword=YOUR_KEY_PASSWORD
